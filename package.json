{
  "name": "testing-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:visual": "playwright test tests/ui/visual-regression.spec.ts",
    "test:headed": "playwright test --project=chromium --headed",
    "test:report": "playwright show-report",
    "clean": "node -e \"const fs=require('fs'); ['test-results', 'playwright-report'].forEach(d => fs.existsSync(d) && fs.rmSync(d, {recursive: true, force: true}))\""
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.8",
    "typescript": "^7.0.2"
  }
}
