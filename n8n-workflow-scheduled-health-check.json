        "url": "https://hooks.slack.com/services/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",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  username: 'QA Health Monitor',\n  text: '[HEALTH CHECK: HEALTHY] Core API is operational.\\n' +\n    '• Endpoint: GET https://reqres.in/api/users?page=1\\n' +\n    '• Status: 200 OK (' + ($json.data ? $json.data.length : 0) + ' records verified)\\n' +\n    '• Timestamp: ' + (new Date().toISOString())\n}) }}",
        "options": {}
      },
