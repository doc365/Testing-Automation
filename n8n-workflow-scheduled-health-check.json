            "version": 3
          },
          "conditions": [
            {
              "id": "789d3456-789a-4cde-9f01-334455667788",
              "leftValue": "={{ ($json.data && Array.isArray($json.data) && $json.data.length > 0) ? 'HEALTHY' : 'UNHEALTHY' }}",
              "rightValue": "HEALTHY",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
